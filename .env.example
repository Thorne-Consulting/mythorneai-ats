APP_PORT=8080
POSTGRES_DB=internal_ats
POSTGRES_USER=ats
POSTGRES_PASSWORD=replace-this-value
# Host port used by direct local API development. Docker Compose keeps PostgreSQL internal.
POSTGRES_HOST_PORT=55433

# Use Development only on a developer machine. Use WorkOS everywhere else.
ASPNETCORE_ENVIRONMENT=Development
AUTH_MODE=WorkOS

# Used only when AUTH_MODE=Oidc. Leave blank for WorkOS.
AUTH_AUTHORITY=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Comma-separated company email domains allowed to sign in.
AUTH_ALLOWED_EMAIL_DOMAINS=company.com

# WorkOS AuthKit settings.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Choose None, Microsoft365, or GoogleWorkspace.
INTEGRATIONS_PROVIDER=None

RESEND_API_KEY=
RESEND_FROM="Hiring team <hiring@example.com>"
# Signing secret of the Resend webhook pointing at /public/webhooks/resend (delivery and bounce tracking). Optional.
RESEND_WEBHOOK_SECRET=
# Domain Resend receives replies on (for example reply.example.com, with its MX record pointing at Resend).
# Turns on reply by email: candidates and the team answer a message from their inbox. Optional.
RESEND_INBOUND_DOMAIN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The model that fills in the resume form. Pin an exact version: parses record it, and the quality test runs against it.
OPENAI_RESUME_MODEL=gpt-5-mini
# Resume and job matching, and interview transcription. The defaults are fine.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1


MICROSOFT365_TENANT_ID=
MICROSOFT365_CLIENT_ID=
MICROSOFT365_CLIENT_SECRET=
MICROSOFT365_SENDER_USER_ID=
MICROSOFT365_CREATE_ONLINE_MEETINGS=true

GOOGLE_WORKSPACE_IMPERSONATED_USER=
GOOGLE_WORKSPACE_CALENDAR_ID=primary
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_WORKSPACE_CREATE_ONLINE_MEETINGS=true

# Currencies. The base currency and the supported list are workspace settings (Settings, then
# Currencies); these three are server settings. Rates come from Frankfurter (112 central banks, no
# key) and are kept for a day; the last good table stays until a new one arrives.
CURRENCY_RATES_URL=https://api.frankfurter.dev/v2/rates?base=EUR
CURRENCY_CACHE_HOURS=24
# false turns conversion off: amounts are shown as entered, nothing is fetched.
CURRENCY_CONVERSION=true

# Files. With S3_ENDPOINT set, uploads live only in that S3-compatible bucket and nothing is
# written to disk. In the compose stack it is http://objects:9000, the object store beside the
# API, and these two keys are its root keys too. Leave S3_ENDPOINT empty on a developer
# machine, where files go to a local folder.
S3_ENDPOINT=
S3_BUCKET=ats-files
S3_ACCESS_KEY=ats
S3_SECRET_KEY=replace-this-value
S3_REGION=us-east-1

# Production hosts (deploy/compose.prod.yaml). Every setting above lives in Infisical there;
# the host keeps only these. The API and the secrets service sign in with this machine identity
# (universal auth) and read INFISICAL_ENV (staging or prod). INFISICAL_IP is Infisical's Netbird
# address; the containers reach INFISICAL_HOSTNAME there.
# BIND_ADDRESS is the host's Netbird address, where the staff door listens.
INFISICAL_API_URL=https://secrets.mythorneai.com
INFISICAL_HOSTNAME=secrets.mythorneai.com
INFISICAL_IP=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=staging
IMAGE_TAG=staging
BIND_ADDRESS=127.0.0.1

# Seeding (docs/production.md, Seeding). SEED_ENVIRONMENT names the seed environment on a host
# (staging or production); empty means the host's own. SEED_PRIVATE_PATH is a SQL file with the
# company's private seed (interview kits, scorecards, pay bands), run only when the file exists.
SEED_ENVIRONMENT=
SEED_PRIVATE_PATH=
# The seed sets the API keeps in place at every start on a host (Development seeds all).
SEED_SETS=

# Per-interviewer calendar OAuth. These are provider app credentials, not WorkOS credentials.
CALENDAR_OAUTH_GOOGLE_CLIENT_ID=
CALENDAR_OAUTH_GOOGLE_CLIENT_SECRET=
CALENDAR_OAUTH_MICROSOFT_CLIENT_ID=
CALENDAR_OAUTH_MICROSOFT_CLIENT_SECRET=
CALENDAR_OAUTH_MICROSOFT_TENANT_ID=common
CALENDAR_OAUTH_REDIRECT_URI=http://localhost:3000/auth/calendar/callback
