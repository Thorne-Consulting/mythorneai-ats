APP_PORT=8080
POSTGRES_DB=internal_ats
POSTGRES_USER=ats
POSTGRES_PASSWORD=replace-this-value
# Host port used by direct local API development. Docker Compose keeps PostgreSQL internal.
POSTGRES_HOST_PORT=55433

# Use Development only on a developer machine. Use WorkOS everywhere else.
ASPNETCORE_ENVIRONMENT=Development
AUTH_MODE=WorkOS

# Used only when AUTH_MODE=Oidc. Leave blank for WorkOS.
AUTH_AUTHORITY=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Comma-separated company email domains allowed to sign in.
AUTH_ALLOWED_EMAIL_DOMAINS=company.com

# WorkOS AuthKit settings.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8080/auth/callback

# Choose None, Microsoft365, or GoogleWorkspace.
INTEGRATIONS_PROVIDER=None

RESEND_API_KEY=
RESEND_FROM="Hiring team <hiring@example.com>"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


MICROSOFT365_TENANT_ID=
MICROSOFT365_CLIENT_ID=
MICROSOFT365_CLIENT_SECRET=
MICROSOFT365_SENDER_USER_ID=
MICROSOFT365_CREATE_ONLINE_MEETINGS=true

GOOGLE_WORKSPACE_IMPERSONATED_USER=
GOOGLE_WORKSPACE_CALENDAR_ID=primary
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_WORKSPACE_CREATE_ONLINE_MEETINGS=true

# Per-interviewer calendar OAuth. These are provider app credentials, not WorkOS credentials.
CALENDAR_OAUTH_GOOGLE_CLIENT_ID=
CALENDAR_OAUTH_GOOGLE_CLIENT_SECRET=
CALENDAR_OAUTH_MICROSOFT_CLIENT_ID=
CALENDAR_OAUTH_MICROSOFT_CLIENT_SECRET=
CALENDAR_OAUTH_MICROSOFT_TENANT_ID=common
CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8080/auth/calendar/callback
