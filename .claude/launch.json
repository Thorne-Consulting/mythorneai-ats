{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ats-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "src/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ats-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/server/MyThorneAI.Ats.Api.csproj"
      ],
      "port": 5080
    }
  ]
}
